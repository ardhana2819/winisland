<!--
  MediaProbe: throwaway Phase 1 spike (U6, backlog B3).
  A console program that reads the Spotify media session through Windows media controls
  and tries each control (play/pause, next, previous, seek, shuffle, repeat), printing what
  Windows answers and what the session reports afterwards.
  Not part of WinIsland.slnx and never referenced by product code.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows$(WindowsTargetVersion)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsMinimumVersion)</SupportedOSPlatformVersion>
  </PropertyGroup>

</Project>
