<!--
  NotificationProbe: throwaway Phase 1 spike (S1, U1, U2, U3, U7).
  A console program that reads Windows toast notifications through UserNotificationListener
  and prints what it sees, so we learn how WhatsApp and Discord behave before building the feature.
  Not part of WinIsland.slnx and never referenced by product code.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows$(WindowsTargetVersion)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsMinimumVersion)</SupportedOSPlatformVersion>
    <!-- The manifest links this exe to the identity package from packaging/ (spike S1). -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

</Project>
