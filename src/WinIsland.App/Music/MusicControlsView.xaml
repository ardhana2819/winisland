<!--
  MusicControlsView.xaml: the music page of the expanded island, 420 x 190 (DESIGN_SPEC section 9).
  Section 9: 16 padding on the left and 30 on the right (room for the page dots), rows 14 apart,
  centered like the prototype. Section 5 for the rest:
    Top row: artwork 64 square, radius 12, 14 gap, title and artist, then the equalizer on the
      right, 12 gap, in the accent color (section 9; the compact pill keeps its green one).
    Middle row: elapsed time, progress bar (4 high, radius 2), total time, 8 gap. The bar sits in
      a 16 high area; with seek support, hovering grows it to 6 high and shows a 10 round thumb.
    Bottom row: previous, play or pause, next, centered, 16 gap; buttons 44 across, icons 22.
      Play or pause is a circle of the accent at 22 percent with the icon in the accent; the
      others have no background and the icon in the accent (section 9).
  Section 3: title 16 semibold (scrolls sideways when too long, see MarqueeText), artist 13,
  time labels 11 tabular.
  Colors (section 9, FR-25) are set from the artwork in MusicControlsView.xaml.cs: grey text,
  fill, thumb, icons and the play circle. The track is white at 18 percent.
  Icons are the prototype's SVG paths, each inside a 24 x 24 Canvas like the SVG viewBox. Without
  that frame, WPF sizes a Path from (0,0) to its far edge and the Viewbox pushes the icon off center.
  Buttons never take keyboard focus (FR-3).
  Empty view (FR-24, DESIGN_SPEC section 9): placeholder artwork, "Not playing", no progress row,
  controls dimmed and not clickable.
  v1.5 (FR-39, DESIGN_SPEC section 12): a speaker button at the right end of the controls row; it
  swaps the progress row for the volume row (VolumeRowView) in the same place. The time labels are
  at least 30 wide, and the volume row's speaker symbols take the same slots.
-->
<UserControl x:Class="WinIsland.App.Music.MusicControlsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:music="clr-namespace:WinIsland.App.Music"
             Width="420"
             Height="190"
             Focusable="False">
    <UserControl.Resources>
        <Style x:Key="IslandButton" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="22">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="16,0,30,0" VerticalAlignment="Center">
        <!-- Top row: artwork, title, artist -->
        <StackPanel Orientation="Horizontal">
            <Border x:Name="Artwork" Width="64" Height="64" CornerRadius="12" />
            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center" Width="269">
                <music:MarqueeText x:Name="TitleText"
                                   AutomationProperties.AutomationId="ExpandedTitle"
                                   Foreground="#FFFFFF"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                <TextBlock x:Name="ArtistText"
                           AutomationProperties.AutomationId="ExpandedArtist"
                           Foreground="#A6ABB6"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <music:EqualizerView x:Name="Equalizer" Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Middle row: elapsed, progress bar, total. Hidden in the empty view (DESIGN_SPEC section 9). -->
        <Grid Margin="0,14,0,0">
        <Grid x:Name="ProgressRow">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ElapsedText"
                       Grid.Column="0"
                       MinWidth="30"
                       VerticalAlignment="Center"
                       Foreground="#A6ABB6"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="11"
                       Typography.NumeralAlignment="Tabular"
                       AutomationProperties.AutomationId="ElapsedTime" />
            <Grid x:Name="SeekArea"
                  Grid.Column="1"
                  Height="16"
                  Margin="8,0,8,0"
                  Background="Transparent"
                  AutomationProperties.Name="Playback position"
                  MouseEnter="OnSeekAreaMouseEnter"
                  MouseLeave="OnSeekAreaMouseLeave"
                  MouseLeftButtonDown="OnSeekAreaMouseDown"
                  MouseMove="OnSeekAreaMouseMove"
                  MouseLeftButtonUp="OnSeekAreaMouseUp">
                <Border x:Name="Track" Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center" />
                <Border x:Name="Fill" Height="4" CornerRadius="2" Background="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0" />
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="#FFFFFF" Canvas.Top="3" Visibility="Hidden" />
                </Canvas>
            </Grid>
            <TextBlock x:Name="TotalText"
                       Grid.Column="2"
                       MinWidth="30"
                       TextAlignment="Right"
                       VerticalAlignment="Center"
                       Foreground="#A6ABB6"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="11"
                       Typography.NumeralAlignment="Tabular"
                       AutomationProperties.AutomationId="TotalTime" />
        </Grid>
        <music:VolumeRowView x:Name="VolumeRow" Opacity="0" IsHitTestVisible="False" />
        </Grid>

        <!-- Bottom row: previous, play or pause, next. At 35 percent and not clickable in the empty view. -->
        <Grid x:Name="ControlsRow" Margin="0,14,0,0">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="PreviousButton" Style="{StaticResource IslandButton}" AutomationProperties.Name="Previous track" Click="OnPreviousClick">
                <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="PreviousIcon" Data="M6 5h2v14H6zM20 5v14L9 12z" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="PlayPauseButton" Style="{StaticResource IslandButton}" Margin="16,0,16,0" AutomationProperties.Name="Pause" Click="OnPlayPauseClick">
                <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="PlayPauseIcon" Data="M7 5h4v14H7zM13 5h4v14h-4z" />
                    </Canvas>
                </Viewbox>
            </Button>
            <Button x:Name="NextButton" Style="{StaticResource IslandButton}" AutomationProperties.Name="Next track" Click="OnNextClick">
                <Viewbox Width="22" Height="22">
                    <Canvas Width="24" Height="24">
                        <Path x:Name="NextIcon" Data="M16 5h2v14h-2zM4 5v14l11-7z" />
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>
        <!-- v1.5 (FR-39): the speaker, right of next, in the same row. -->
        <Button x:Name="SpeakerButton" Style="{StaticResource IslandButton}" HorizontalAlignment="Right" AutomationProperties.Name="Volume" Click="OnSpeakerClick">
            <Viewbox Width="20" Height="20">
                <Canvas Width="24" Height="24">
                    <Path x:Name="SpeakerIcon" Data="M3 9v6h4l5 5V4L7 9z" />
                </Canvas>
            </Viewbox>
        </Button>
        </Grid>
    </StackPanel>
</UserControl>
