<!--
  VolumeRowView.xaml: the volume of the music app (PRD FR-39, DESIGN_SPEC section 12). It takes
  the progress row's exact place: the two speaker symbols sit where the times are, in slots as wide
  as the time labels (set from MusicControlsView), and the bar has the progress bar's length and
  shape: 16 high hit area, 4 high track in white at 18 percent, 6 high with a 10 round thumb on
  hover. White for every artwork, so it is never mistaken for the song's progress (Diva, 3 Nov 2026).
  Speaker symbols 14 high, measured by their drawn shape, so both sit exactly 8 from the bar.
  Clicking the quiet speaker sets the volume to 0, the loud one to full (Diva, 4 Nov 2026); each
  takes its whole slot as the click area.
-->
<UserControl x:Class="WinIsland.App.Music.VolumeRowView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftSlot" Width="30" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightSlot" Width="30" />
        </Grid.ColumnDefinitions>
        <Border x:Name="QuietEnd"
                Grid.Column="0"
                Background="Transparent"
                Cursor="Hand"
                AutomationProperties.Name="Mute the music app"
                MouseLeftButtonDown="OnQuietEndClick"
                MouseLeftButtonUp="OnEndMouseUp">
            <Path Height="14"
                  Stretch="Uniform"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Center"
                  Fill="#FFFFFF"
                  Data="M3 9v6h4l5 5V4L7 9z" />
        </Border>
        <Grid x:Name="BarArea"
              Grid.Column="1"
              Height="16"
              Margin="8,0,8,0"
              Background="Transparent"
              Cursor="Hand"
              AutomationProperties.Name="Volume of the music app"
              MouseEnter="OnBarMouseEnter"
              MouseLeave="OnBarMouseLeave"
              MouseLeftButtonDown="OnBarMouseDown"
              MouseMove="OnBarMouseMove"
              MouseLeftButtonUp="OnBarMouseUp">
            <Border x:Name="Track" Height="4" CornerRadius="2" Background="#2EFFFFFF" VerticalAlignment="Center" />
            <Border x:Name="Fill" Height="4" CornerRadius="2" Background="#FFFFFF" VerticalAlignment="Center" HorizontalAlignment="Left" Width="0" />
            <Canvas IsHitTestVisible="False">
                <Ellipse x:Name="Thumb" Width="10" Height="10" Fill="#FFFFFF" Canvas.Top="3" Visibility="Hidden" />
            </Canvas>
        </Grid>
        <Border x:Name="LoudEnd"
                Grid.Column="2"
                Background="Transparent"
                Cursor="Hand"
                AutomationProperties.Name="Music app at full volume"
                MouseLeftButtonDown="OnLoudEndClick"
                MouseLeftButtonUp="OnEndMouseUp">
            <Path Height="14"
                  Stretch="Uniform"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Fill="#FFFFFF"
                  Data="M3 9v6h4l5 5V4L7 9zm13.5 3A4.5 4.5 0 0 0 14 8v8a4.5 4.5 0 0 0 2.5-4zM14 3.2v2.1a7 7 0 0 1 0 13.4v2.1a9 9 0 0 0 0-17.6z" />
        </Border>
    </Grid>
</UserControl>
