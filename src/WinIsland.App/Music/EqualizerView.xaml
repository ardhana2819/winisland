<!--
  EqualizerView.xaml: the five small bars, in the artwork's accent in the compact music pill and
  on the music page (PRD FR-48, DESIGN_SPEC section 15; the color is set with SetBarBrush).
  Five bars, 3 wide, 2 apart, in a box 16 high. Each bar is centered and grows up and down from
  its middle, with round ends, so at its lowest (3 high) it is a dot.
  The motion is in EqualizerView.xaml.cs.
-->
<UserControl x:Class="WinIsland.App.Music.EqualizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="23"
             Height="16"
             Focusable="False">
    <StackPanel Orientation="Horizontal">
        <Rectangle x:Name="BarOne" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#4ADE80" VerticalAlignment="Center" />
        <Rectangle x:Name="BarTwo" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#4ADE80" VerticalAlignment="Center" Margin="2,0,0,0" />
        <Rectangle x:Name="BarThree" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#4ADE80" VerticalAlignment="Center" Margin="2,0,0,0" />
        <Rectangle x:Name="BarFour" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#4ADE80" VerticalAlignment="Center" Margin="2,0,0,0" />
        <Rectangle x:Name="BarFive" Width="3" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#4ADE80" VerticalAlignment="Center" Margin="2,0,0,0" />
    </StackPanel>
</UserControl>
