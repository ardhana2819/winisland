<!--
  EqualizerView.xaml: the three small green bars in the compact music pill.
  DESIGN_SPEC section 5: three bars, 3 wide, 3 apart, up to 16 high, color #4ADE80 (section 4).
  The motion is in EqualizerView.xaml.cs.
-->
<UserControl x:Class="WinIsland.App.Music.EqualizerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="15"
             Height="16"
             Focusable="False">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
        <Rectangle x:Name="BarOne" Width="3" Height="5" Fill="#4ADE80" VerticalAlignment="Bottom" />
        <Rectangle x:Name="BarTwo" Width="3" Height="5" Fill="#4ADE80" VerticalAlignment="Bottom" Margin="3,0,0,0" />
        <Rectangle x:Name="BarThree" Width="3" Height="5" Fill="#4ADE80" VerticalAlignment="Bottom" Margin="3,0,0,0" />
    </StackPanel>
</UserControl>
