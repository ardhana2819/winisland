<!--
  MusicPillView.xaml: the compact music pill, 280 x 36 (DESIGN_SPEC section 2).
  Section 5: left padding 6, right padding 12, artwork 24 square with radius 6, 10 gap,
  title fills the middle, equalizer on the right. v1.3: the unread dot (FR-33) is the last item,
  10 after the equalizer (DESIGN_SPEC section 10).
  Section 3: title 13, regular, one line. Too long titles scroll sideways (Diva's request,
  31 Oct 2026, replacing the ellipsis in the design); see MarqueeText.
-->
<UserControl x:Class="WinIsland.App.Music.MusicPillView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:music="clr-namespace:WinIsland.App.Music"
             xmlns:notifications="clr-namespace:WinIsland.App.Notifications"
             Width="280"
             Height="36"
             Focusable="False">
    <Grid Margin="6,0,12,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Border x:Name="Artwork" Grid.Column="0" Width="24" Height="24" CornerRadius="6" VerticalAlignment="Center" />

        <music:MarqueeText x:Name="TitleText"
                           Grid.Column="1"
                           Margin="10,0,10,0"
                           VerticalAlignment="Center"
                           Foreground="#FFFFFF"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           AutomationProperties.AutomationId="MusicPillTitle" />

        <music:EqualizerView x:Name="Equalizer" Grid.Column="2" VerticalAlignment="Center" />

        <notifications:IslandDot x:Name="UnreadDot" Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" />
        <!-- Camera or microphone in use (v1.5, FR-40): the last item, after the unread dot. -->
        <notifications:IslandDot x:Name="PrivacyDot" Grid.Column="4" Margin="4,0,0,0" VerticalAlignment="Center" />
    </Grid>
</UserControl>
