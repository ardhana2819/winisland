<!--
  NotificationBannerView.xaml: the notification banner, 420 x 72 (DESIGN_SPEC section 2).
  Section 5: 16 side padding, 12 gap, icon circle 40, sender above preview, +N badge on the
  right (radius 12, padding 3 by 9), hidden when there is only one.
  Section 3: sender 14 semibold, preview 13 one line with ellipsis, badge text 12 semibold.
  Section 4: preview #A6ABB6, badge background #2C2C2E.
  Tap opens the list; a sideways drag of more than 40 swipes the banner away (section 6).
-->
<UserControl x:Class="WinIsland.App.Notifications.NotificationBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notifications="clr-namespace:WinIsland.App.Notifications"
             Width="420"
             Height="72"
             Focusable="False"
             Cursor="Hand"
             Background="Transparent"
             MouseLeftButtonDown="OnMouseDown"
             MouseMove="OnMouseMove"
             MouseLeftButtonUp="OnMouseUp">
    <Grid x:Name="BannerContent" Margin="16,0,16,0">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="SwipeOffset" />
        </Grid.RenderTransform>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <notifications:AppIconView x:Name="Icon" Grid.Column="0" Width="40" Height="40" VerticalAlignment="Center" />

        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
            <TextBlock x:Name="SenderText"
                       AutomationProperties.AutomationId="BannerSender"
                       Foreground="#FFFFFF"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="14"
                       FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="PreviewText"
                       AutomationProperties.AutomationId="BannerPreview"
                       Foreground="#A6ABB6"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="13"
                       TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <Border x:Name="Badge"
                Grid.Column="2"
                VerticalAlignment="Center"
                Background="#2C2C2E"
                CornerRadius="12"
                Padding="9,3,9,3">
            <TextBlock x:Name="BadgeText"
                       AutomationProperties.AutomationId="BannerBadge"
                       Foreground="#FFFFFF"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="12"
                       FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
