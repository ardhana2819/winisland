<!--
  NotificationBannerView.xaml: the notification banner, 420 x 72 (DESIGN_SPEC section 2).
  Section 9 (v1.1): the black pill holds one grey card inset by 8: 56 high, radius 28 (the pill's
  36 minus 8), #1C1C1E, padding 10 on the left and 14 on the right, icon circle 36, 10 gap,
  sender above preview, and the +N badge on the right (#3A3A3C so it stands out on the card,
  radius 12, padding 3 by 9), hidden when there is only one. No time: a banner is always "now".
  The card never grows past the pill: long text is cut with an ellipsis.
  Section 3: sender 14 semibold, preview 13 one line with ellipsis, badge text 12 semibold.
  Tap opens the notifications page; a sideways drag of more than 40 swipes the banner away (section 6).
  v1.4: the same view is also the call banner (FR-38, ShowCall): caller, "Incoming voice call" or
  "Incoming video call", and the green call circle instead of the badge; tapping it does nothing.
  Colors come from IslandLookResources, so the Glass look (FR-37) can change them.
-->
<UserControl x:Class="WinIsland.App.Notifications.NotificationBannerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:notifications="clr-namespace:WinIsland.App.Notifications"
             Width="420"
             Height="72"
             Focusable="False"
             Cursor="Hand"
             Background="Transparent"
             MouseLeftButtonDown="OnMouseDown"
             MouseMove="OnMouseMove"
             MouseLeftButtonUp="OnMouseUp">
    <Border x:Name="BannerContent"
            Margin="8"
            Background="{DynamicResource IslandCardBrush}"
            CornerRadius="28"
            Padding="10,0,14,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="SwipeOffset" />
        </Border.RenderTransform>
        <Grid x:Name="Row">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <notifications:AppIconView x:Name="Icon" Grid.Column="0" Width="36" Height="36" LetterSize="16" VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                <TextBlock x:Name="SenderText"
                           AutomationProperties.AutomationId="BannerSender"
                           Foreground="#FFFFFF"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="14"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PreviewText"
                           AutomationProperties.AutomationId="BannerPreview"
                           Foreground="{DynamicResource IslandSecondaryTextBrush}"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="13"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border x:Name="Badge"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Background="{DynamicResource IslandBadgeBrush}"
                    CornerRadius="12"
                    Padding="9,3,9,3">
                <TextBlock x:Name="BadgeText"
                           AutomationProperties.AutomationId="BannerBadge"
                           Foreground="#FFFFFF"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           FontSize="12"
                           FontWeight="SemiBold" />
            </Border>
        </Grid>
    </Border>
</UserControl>
