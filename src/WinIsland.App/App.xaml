<!--
  App.xaml: the WPF application entry point.
  The app has no main window in the usual sense: it runs until Quit is chosen in the tray,
  so it shuts down only when told to (ShutdownMode="OnExplicitShutdown").
-->
<Application x:Class="WinIsland.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources />
</Application>
