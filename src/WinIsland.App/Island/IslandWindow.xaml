<!--
  IslandWindow.xaml: the island itself. A transparent, borderless, always-on-top window at the
  top center of the primary monitor, holding the black pill.
  Look and sizes follow docs/design/DESIGN_SPEC.md:
    section 2: compact idle pill 120 x 34, corner radius 17, 12 from the top edge.
    section 3: clock 15, semibold, tabular numbers, Segoe UI Variable then Segoe UI.
    section 4: pill #000000, text #FFFFFF.
  Everything inside IslandRoot is drawn at the base size and scaled as a whole (FR-1).
  No drop shadow: DESIGN_SPEC section 4 makes it optional, and leaving it out keeps the window light.
-->
<Window x:Class="WinIsland.App.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinIsland"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False">
    <Grid x:Name="IslandRoot"
          Width="480"
          Height="230"
          HorizontalAlignment="Left"
          VerticalAlignment="Top">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="IslandScaleTransform" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <Border x:Name="Pill"
                Width="120"
                Height="34"
                CornerRadius="17"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="#000000">
            <TextBlock x:Name="ClockLabel"
                       AutomationProperties.AutomationId="ClockText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="#FFFFFF"
                       FontFamily="Segoe UI Variable Text, Segoe UI"
                       FontSize="15"
                       FontWeight="SemiBold"
                       Typography.NumeralAlignment="Tabular" />
        </Border>
    </Grid>
</Window>
