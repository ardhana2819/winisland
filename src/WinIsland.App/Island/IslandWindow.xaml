<!--
  IslandWindow.xaml: the island itself. A transparent, borderless, always-on-top window at the
  top center of the primary monitor, holding the black pill.
  Look and sizes follow docs/design/DESIGN_SPEC.md:
    section 2: compact idle pill 120 x 34 (radius 17); hotkey conflict banner 400 x 52 (radius 26);
               12 from the top edge.
    section 3: clock 15 semibold, tabular numbers; banner text 13; Segoe UI Variable then Segoe UI.
    section 4: pill #000000, text #FFFFFF, warning icon #FBBF24.
    section 5: conflict banner padding 16 on the left and 10 on the right, 10 gap, 20 warning icon,
               then a Change button styled like Allow.
  The compact music pill (280 x 36) is MusicPillView in the Music folder. The expanded island
  (420 x 190, v1.1) is ExpandedIslandView next to this file: two pages, MusicControlsView and
  NotificationsPageView, with page dots (FR-21).
  The notification banner (420 x 72), the call banner (the same view, v1.4) and the permission
  prompt (360 x 52) are in the Notifications folder.
  Each view is a layer of its own size, centered in the pill, like the prototype. Only the active
  layer is visible; PillAnimator swaps them.
  Everything inside IslandRoot is drawn at the base size and scaled as a whole (FR-1, FR-32).
  IslandGrowScale is only used while the island size changes (IslandResizeAnimator). It sits on
  IslandFrame, which always fills the window, so it grows from the window's top center, where the
  island hangs. On IslandRoot itself the grow center would be worked out from the unscaled 480
  width and land left of center (seen in Diva's video, 2 Nov 2026).
  No drop shadow: DESIGN_SPEC section 4 makes it optional, and leaving it out keeps the window light.
-->
<Window x:Class="WinIsland.App.Island.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:island="clr-namespace:WinIsland.App.Island"
        xmlns:music="clr-namespace:WinIsland.App.Music"
        xmlns:notifications="clr-namespace:WinIsland.App.Notifications"
        Title="WinIsland"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False">
    <Grid x:Name="IslandFrame" RenderTransformOrigin="0.5,0">
        <Grid.RenderTransform>
            <ScaleTransform x:Name="IslandGrowScale" ScaleX="1" ScaleY="1" />
        </Grid.RenderTransform>
        <Grid x:Name="IslandRoot"
              Width="480"
              Height="230"
              HorizontalAlignment="Center"
              VerticalAlignment="Top">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="IslandScaleTransform" ScaleX="1" ScaleY="1" />
            </Grid.LayoutTransform>

            <Border x:Name="Pill"
                    Width="120"
                    Height="34"
                    CornerRadius="17"
                    Margin="0,12,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Background="#000000"
                    RenderTransformOrigin="0.5,0.5"
                    MouseLeftButtonUp="OnPillClicked"
                    MouseWheel="OnPillMouseWheel">
                <Border.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="PillOffset" />
                        <ScaleTransform x:Name="PillScale" />
                    </TransformGroup>
                </Border.RenderTransform>

                <Grid>
                    <!-- Shade over the artwork color on the open music page, fading to black at the
                         bottom (DESIGN_SPEC section 9). PillColors fades it in and out. -->
                    <Border x:Name="PillShade" IsHitTestVisible="False" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#99000000" Offset="0.6" />
                                <GradientStop Color="#FF000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- v1.7 Glass music page (FR-45, DESIGN_SPEC section 13): the artwork color over
                         the blur, 90 percent at the top, 50 percent at 45 percent of the height, none at
                         the bottom. PillColors sets the color and fades it in and out. -->
                    <Border x:Name="PillGlassTint" IsHitTestVisible="False" Opacity="0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="GlassTintTop" Color="#00000000" Offset="0" />
                                <GradientStop x:Name="GlassTintMiddle" Color="#00000000" Offset="0.45" />
                                <GradientStop x:Name="GlassTintBottom" Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Compact, idle: the clock. -->
                    <Grid x:Name="ClockLayer"
                          Width="120"
                          Height="34"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>
                        <TextBlock x:Name="ClockLabel"
                                   AutomationProperties.AutomationId="ClockText"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FFFFFF"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Typography.NumeralAlignment="Tabular" />
                        <!-- Unread dot (FR-33): 12 from the right edge, the clock stays centered. -->
                        <notifications:IslandDot x:Name="ClockUnreadDot"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0" />
                        <!-- Camera or microphone in use (v1.5, FR-40): at the right end; the unread dot then moves 10 left. -->
                        <notifications:IslandDot x:Name="ClockPrivacyDot"
                                                 HorizontalAlignment="Right"
                                                 VerticalAlignment="Center"
                                                 Margin="0,0,12,0" />
                    </Grid>

                    <!-- Hotkey conflict banner. Starts hidden. Change opens Settings (DESIGN_SPEC section 2). -->
                    <Grid x:Name="ConflictLayer"
                          Width="400"
                          Height="52"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Opacity="0"
                          IsHitTestVisible="False"
                          RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                        </Grid.RenderTransform>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="16,0,16,0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#FBBF24" Data="M12 2 1 21h22zM11 10h2v5h-2zM11 17h2v2h-2z" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock x:Name="ConflictLabel"
                                       AutomationProperties.AutomationId="ConflictText"
                                       Margin="10,0,0,0"
                                       MaxWidth="240"
                                       VerticalAlignment="Center"
                                       Foreground="#FFFFFF"
                                       FontFamily="Segoe UI Variable Text, Segoe UI"
                                       FontSize="13"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Focusable="False"
                                Cursor="Hand"
                                AutomationProperties.Name="Change"
                                Click="OnConflictChangeClicked">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="#FFFFFF" CornerRadius="16" Padding="16,7,16,7">
                                        <TextBlock Text="Change"
                                                   Foreground="#000000"
                                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                                   FontSize="13"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <!-- Compact, music: artwork, title, equalizer. -->
                    <music:MusicPillView x:Name="MusicLayer"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Opacity="0"
                                         IsHitTestVisible="False"
                                         RenderTransformOrigin="0.5,0.5">
                        <music:MusicPillView.RenderTransform>
                            <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                        </music:MusicPillView.RenderTransform>
                    </music:MusicPillView>

                    <!-- Expanded: the music and notifications pages. -->
                    <island:ExpandedIslandView x:Name="ExpandedLayer"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Opacity="0"
                                               IsHitTestVisible="False"
                                               RenderTransformOrigin="0.5,0.5">
                        <island:ExpandedIslandView.RenderTransform>
                            <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                        </island:ExpandedIslandView.RenderTransform>
                    </island:ExpandedIslandView>

                    <!-- Notification banner. -->
                    <notifications:NotificationBannerView x:Name="BannerLayer"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Opacity="0"
                                                          IsHitTestVisible="False"
                                                          RenderTransformOrigin="0.5,0.5">
                        <notifications:NotificationBannerView.RenderTransform>
                            <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                        </notifications:NotificationBannerView.RenderTransform>
                    </notifications:NotificationBannerView>

                    <!-- Call banner (v1.4, FR-38): the banner view in call mode, over message banners. -->
                    <notifications:NotificationBannerView x:Name="CallLayer"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Opacity="0"
                                                          IsHitTestVisible="False"
                                                          RenderTransformOrigin="0.5,0.5">
                        <notifications:NotificationBannerView.RenderTransform>
                            <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                        </notifications:NotificationBannerView.RenderTransform>
                    </notifications:NotificationBannerView>

                    <!-- Permission prompt. -->
                    <notifications:PermissionPromptView x:Name="PermissionLayer"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        Opacity="0"
                                                        IsHitTestVisible="False"
                                                        RenderTransformOrigin="0.5,0.5">
                        <notifications:PermissionPromptView.RenderTransform>
                            <ScaleTransform ScaleX="0.88" ScaleY="0.88" />
                        </notifications:PermissionPromptView.RenderTransform>
                    </notifications:PermissionPromptView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
