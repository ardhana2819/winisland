<!--
  SettingsWindow.xaml: WinIsland's settings (PRD section 4, FR-19, FR-20), laid out like the
  "Settings and tray" design board: a dark card (#1C1C1E, border #2C2C2E, radius 10), title 18
  semibold, rows 14 with a separator (#2C2C2E), hotkey buttons (#2C2C2E, border #48484A,
  radius 6), the hotkey error in amber (#FBBF24, 12), and switches with the green accent (#4ADE80).
  Unlike the island, this is a normal window: it is opened on purpose and takes keyboard focus,
  so every control works with the keyboard (PRD section 7, accessibility).
  v1.3: the title bar shows the WinIsland icon (FR-34) and there is an Island size row (FR-32).
-->
<Window x:Class="WinIsland.App.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinIsland settings"
        Icon="/Assets/WinIsland.ico"
        Width="620"
        SizeToContent="Height"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#161618"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7" />
        <SolidColorBrush x:Key="LineBrush" Color="#2C2C2E" />
        <SolidColorBrush x:Key="ControlBrush" Color="#2C2C2E" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#48484A" />
        <SolidColorBrush x:Key="FocusBrush" Color="#6EA0FF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4ADE80" />

        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="HotkeyButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Frame"
                                Background="{StaticResource ControlBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="14,6,14,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box"
                                Width="20"
                                Height="20"
                                CornerRadius="4"
                                Background="{StaticResource ControlBrush}"
                                BorderBrush="{StaticResource ControlBorderBrush}"
                                BorderThickness="1">
                            <Path x:Name="Tick"
                                  Data="M4,10 L8,14 L16,6"
                                  Stroke="#000000"
                                  StrokeThickness="2"
                                  Visibility="Collapsed" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The design board shows a dropdown; WPF's default one is light, so it gets a dark look. -->
        <Style x:Key="DarkDropdown" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinWidth" Value="130" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Opener"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="#2C2C2E" BorderBrush="#48484A" BorderThickness="1" CornerRadius="6" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Border x:Name="FocusFrame" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False" />
                            <Grid IsHitTestVisible="False" Margin="10,6,10,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" />
                                <Path Grid.Column="1" Margin="8,0,0,0" Data="M0,0 L4,4 L8,0" Stroke="#FFFFFF" StrokeThickness="1.5" VerticalAlignment="Center" />
                            </Grid>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                                <Border Background="#1C1C1E" BorderBrush="#48484A" BorderThickness="1" CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="240">
                                    <ScrollViewer>
                                        <ItemsPresenter />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="FocusFrame" Property="BorderBrush" Value="{StaticResource FocusBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#FFFFFF" />
                        <Setter Property="Padding" Value="10,5,10,5" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border x:Name="ItemBack" Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsHighlighted" Value="True">
                                            <Setter TargetName="ItemBack" Property="Background" Value="#2C2C2E" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="24" Padding="24,20,24,20" Background="#1C1C1E" BorderBrush="#2C2C2E" BorderThickness="1" CornerRadius="10">
        <StackPanel>
            <TextBlock Text="WinIsland settings" Foreground="{StaticResource TextBrush}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />

            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                <DockPanel>
                    <Button x:Name="ExpandHotkeyButton" DockPanel.Dock="Right" Style="{StaticResource HotkeyButton}" AutomationProperties.Name="Expand island hotkey" Click="OnHotkeyButtonClick" />
                    <TextBlock Text="Expand island hotkey" Style="{StaticResource RowLabel}" />
                </DockPanel>
            </Border>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                <DockPanel>
                    <Button x:Name="HideShowHotkeyButton" DockPanel.Dock="Right" Style="{StaticResource HotkeyButton}" AutomationProperties.Name="Hide or show hotkey" Click="OnHotkeyButtonClick" />
                    <TextBlock Text="Hide / show hotkey" Style="{StaticResource RowLabel}" />
                </DockPanel>
            </Border>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                <DockPanel>
                    <Button x:Name="HideNotificationsHotkeyButton" DockPanel.Dock="Right" Style="{StaticResource HotkeyButton}" AutomationProperties.Name="Hide notifications hotkey" Click="OnHotkeyButtonClick" />
                    <TextBlock Text="Hide notifications hotkey" Style="{StaticResource RowLabel}" />
                </DockPanel>
            </Border>
            <TextBlock x:Name="ProblemText"
                       AutomationProperties.AutomationId="SettingsProblem"
                       Foreground="#FBBF24"
                       FontSize="12"
                       Margin="0,6,0,0"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />

            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                <DockPanel>
                    <ComboBox x:Name="SizeBox" DockPanel.Dock="Right" Style="{StaticResource DarkDropdown}" AutomationProperties.Name="Island size" SelectionChanged="OnSizeChanged" />
                    <TextBlock Text="Island size" Style="{StaticResource RowLabel}" />
                </DockPanel>
            </Border>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                <DockPanel>
                    <ComboBox x:Name="DurationBox" DockPanel.Dock="Right" Style="{StaticResource DarkDropdown}" AutomationProperties.Name="Notification duration" SelectionChanged="OnDurationChanged" />
                    <TextBlock Text="Notification duration" Style="{StaticResource RowLabel}" />
                </DockPanel>
            </Border>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                <DockPanel>
                    <CheckBox x:Name="WhatsAppSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Show WhatsApp notifications" Click="OnSwitchClick" />
                    <TextBlock Text="Show WhatsApp notifications" Style="{StaticResource RowLabel}" />
                </DockPanel>
            </Border>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                <DockPanel>
                    <CheckBox x:Name="DiscordSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Show Discord notifications" Click="OnSwitchClick" />
                    <TextBlock Text="Show Discord notifications" Style="{StaticResource RowLabel}" />
                </DockPanel>
            </Border>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                <DockPanel>
                    <CheckBox x:Name="OtherAppsSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Show other Windows apps" Click="OnSwitchClick" />
                    <TextBlock Text="Show other Windows apps" Style="{StaticResource RowLabel}" />
                </DockPanel>
            </Border>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                <DockPanel>
                    <CheckBox x:Name="HideTextSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Hide message text" Click="OnSwitchClick" />
                    <TextBlock Text="Hide message text" Style="{StaticResource RowLabel}" />
                </DockPanel>
            </Border>
            <!-- v1.4 (FR-36): off by default; the note says what hiding then does. -->
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="0,12,0,12">
                <DockPanel>
                    <CheckBox x:Name="ClearFromWindowsSwitch" DockPanel.Dock="Right" VerticalAlignment="Top" Style="{StaticResource Switch}" AutomationProperties.Name="Also clear from Windows notification center" Click="OnSwitchClick" />
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="Also clear from Windows notification center" Style="{StaticResource RowLabel}" TextWrapping="Wrap" />
                        <TextBlock Text="Swiping a banner, or the hide hotkey on banners, also removes that chat from Windows and from the notifications page. It does not mark it read in the app."
                                   Foreground="#A6ABB6"
                                   FontSize="12"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Padding="0,12,0,4">
                <DockPanel>
                    <CheckBox x:Name="StartupSwitch" DockPanel.Dock="Right" Style="{StaticResource Switch}" AutomationProperties.Name="Launch with Windows" Click="OnSwitchClick" />
                    <TextBlock Text="Launch with Windows" Style="{StaticResource RowLabel}" />
                </DockPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
