<!--
  WinIsland.Platform: thin wrappers around Windows APIs (media session,
  notification listener, global hotkeys, tray, startup).
  Targets a Windows SDK version so the Windows.* APIs are available.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows$(WindowsTargetVersion)</TargetFramework>
    <SupportedOSPlatformVersion>$(WindowsMinimumVersion)</SupportedOSPlatformVersion>
    <!-- The tray icon uses the WinForms NotifyIcon that ships with .NET (PRD FR-6), so no extra package. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Needed by the code that LibraryImport generates for NativeMethods.cs, and by GlassBackdrop.cs,
         which calls one COM method that .NET has no projection for through its vtable (v1.4, FR-37). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinIsland.Core\WinIsland.Core.csproj" />
  </ItemGroup>

</Project>
